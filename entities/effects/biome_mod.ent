EntityBlueprint "effects/no_lifetime"  // ion_storm
{
	name effects/biome_mod/ion_storm

	LuaDesc
	{
		script "lua/misc/jammer.lua"

		database
		{
			jamming_range				float:"2000"
			jamming_strength			float:"1.5"
			interference_global			int:"1"
		}
	}
	
	BiomeModificatorComponent
	{
		solar_power "4.0000"
		geothermal_power "4.000"
	}
	
	TypeDesc
	{
		type "jammer"
	}
}

EntityBlueprint "effects/no_lifetime"  // ion_storm_anomaly
{
	name effects/biome_mod/ion_storm_anomaly

	LuaDesc
	{
		script "lua/misc/jammer.lua"

		database
		{
			jamming_range				float:"800"
			jamming_range_minimap		float:"150"
			jamming_strength			float:"1.5"
			jamming_random_pos			int:"0"
		}
	}

	TriggerDesc
	{
		owner 		"self"
		collision 	"ground_unit"

		Filters
		{
			TeamTriggerFilter 
			{
				team		"player"
			}
		}

		Shapes
		{
			PhysicsSphereShape
			{
				r "150"
			}
		}
	}
	
	BiomeModificatorComponent
	{
		solar_power "4.0000"
		geothermal_power "4.000"
	}
	
	TypeDesc
	{
		type "jammer"
	}
}

