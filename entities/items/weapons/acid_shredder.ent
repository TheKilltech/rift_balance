EntityBlueprint  // acid_shredder
{
	name "items/weapons/acid_shredder"

	MeshDesc
	{
		mesh 		"meshes/items/weapons/minigun.mesh"
		material 	"items/weapons/minigun"
	}
	
 	ShadowExcludeComponent
	{

	}		

	SkeletonDesc
	{
		name "meshes/items/weapons/acid_shredder"
	}

	AnimationGraphDesc
	{
		animation_graph_name "weapon"
	}

	WeaponMovementDataComponent
	{
		attack_movement_factor	"0.35"
	}
	
	WeaponPredictionComponent
	{
		spawn_ammo "1"
	}

	BurstWeaponComponent
	{
		WeaponAffector
		{
			emissive_time "0.35"
			emissive_factor  "4"
		}		
		WeaponMuzzles
		{
			WeaponMuzzle
			{
				attachment "att_muzzle_1"
			}
		}

		ammo_blueprint 				"mech/acid_shredder_projectile"

		muzzles_per_fire 			"1"
		muzzle_flash_effect 		"effects/weapons_bullet/minigun_muzzle"

		burst_column_spacing 		"0.9"
		burst_rate 					"0.3"
		//burst_column_angle 			"5"
	}

	EffectDesc
	{
		EffectGroup
		{
			group "vismod"
			enabled "1"
			Effects
			{
				Effect
				{
					blueprint "effects/weapon_items/ball_gas"
					bone 	"att_vismod_acid"
					scale	1 3 1
				}
			}
		}
		EffectGroup
		{
			group "loot"
			enabled "0"
			
			Effects
			{
				Effect
				{
					blueprint "effects/loot/mech_lost_weapon_marker"
					offset "1 0 0"
				}
			}
		}		
		
		EffectGroup
		{
			group "loot_collect"
			enabled "0"		
			
			Effects
			{
				Effect
				{
					blueprint "effects/weapons_bullet/sniper_rifle_equipped"
				}
			}
		}			
		
		EffectGroup
		{
			group "item_equipped"
			enabled "0"

			Effects
			{
				Effect
				{
					blueprint "effects/weapons_bullet/minigun_equipped"
				}
			}
		}

		EffectGroup
		{
			group "shooting"
			enabled "0"

			Effects
			{
				Effect
				{
					blueprint "effects/weapons_bullet/minigun_fire_loop"
				}
			}
		}
		EffectGroup
		{
			group "shooting_empty"
			enabled "0"

			Effects
			{
				Effect
				{
					blueprint "effects/weapons_bullet/empty_big_bullet_weapon"
				}
			}
		}

		EffectGroup
		{
			group "laser_pointer"
			enabled "1"

			Effects
			{
				Effect
				{
					blueprint "effects/mech/laser_pointer"
					bone "att_muzzle_1"
				}
			}
		}

		EffectGroup
		{
			group "item_deactivated"
			enabled "0"

			Effects
			{
				Effect
				{
					blueprint "effects/weapons_bullet/minigun_fire_stop"
				}
			}
		}
	}
}

