EntityBlueprint  // acid_shredder_projectile
{
	name			"mech/acid_shredder_projectile"
	base_blueprint	"buildings/defense/tower_acid_shredder_projectile"

	ProjectileAmmoComponent
	{
		on_enemy_hit_effect 	"effects/weapons_bullet/tower_acid_shredder_hit"
		on_world_hit_effect 	"effects/weapons_bullet/tower_acid_shredder_hit"
		on_resisted_hit_effect 	"effects/weapons_generic/projectile_hit_resisted"
		collision_3d 			"world|world_blocker|world_destructible|destructible|ground_unit|air_unit|shield|building"
		
		cluster_enemy_spread    "360"
		cluster_world_spread	"360"
		cluster_life_time_min   "0.1"
		cluster_life_time_max   "0.3"
		diameter				"1"
		cluster_scale
		{
			x "0.8"
			y "0.5"
			z "0.5"
		}
	}

	LifeTimeDesc
	{
		time 		0.2
		type 		"camera"
	}
}
