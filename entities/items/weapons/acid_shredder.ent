EntityBlueprint  // acid_shredder_advanced_item
{
	name "items/weapons/acid_shredder_advanced_item"

	InventoryItemDesc
	{
		type 		"range_weapon"
		subtype		"low_caliber"
		name 		"gui/menu/inventory/weapon_name/acid_shredder"
		holding_pose "range"
		item_bp		"items/weapons/acid_shredder_advanced"
		icon		"gui/hud/items_icons/weapons/acid_shredder_advanced"
		bigger_icon "gui/menu/items_icons/weapons/acid_shredder_advanced"
		predict		1
	}

	LuaDesc
	{
		script "lua/items/weapons/autofire_weapon.lua"
		database
		{
			animation_speed				float:"2"
			pad_equipped_feedback 		string:"vibration,5,4,100"
		}
	}

	WeaponItemDesc
	{
	}

	CostDesc
}

