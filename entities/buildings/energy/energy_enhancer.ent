EntityBlueprint  // energy_enhancer
{
	name			"buildings/energy/energy_enhancer"
	base_blueprint	"buildings/energy/energy_storage"

	BuildingDesc
	{
		name 				"energy_enhancer"
		bp   				"buildings/energy/energy_enhancer"
		category 			"energy"
		localization_id		"gui/hud/building_name/energy_enhancer"
		description			"gui/hud/building_description/energy_enhancer"
		menu_icon			"gui/hud/building_icons/energy_enhancer_lvl_1"
		type				"energy_stab_large"
		overrides			"energy_storage_small,energy_stab_large,pipe"
		buildable			"0"
		building_group		"energy_storage"
		require 			"headquarters"
		upgrade				"buildings/energy/energy_enhancer_lvl_2"
		exclude_terrain_types "magma_hot_ground,magma_very_hot_ground"

		costs
		{
			BuildingCostInfo
			{
				name "default"
				building_time 60
				building_cost
				{
					carbonium	"1500"
					steel		"2500"
					palladium	"500"
					ai			"3"
				}
			}
		}
	}

	ResourceConverterDesc
	{
		in
		{
			GameplayResource
			{
				resource 	"resin"
				value 		"12"
				family		"enhancer"
				attachment	"att_in_1"
			}
			GameplayResource
			{
				resource 	"plasma"
				value 		"500"
				family		"enhancer"
				attachment	"att_in_1"
			}
		}
		
		out
		{
		}
		priority 9
		reset_interval 0.5
	}
	
	ResourceStorageDesc
	{
		Storages
		{
			Storage
			{
				resource "energy"
				max 	 "100000"
			}
		}
	}

	LuaDesc
	{
		script "lua/buildings/buff_source.lua"

		database
		{
			cone_effect					string:"build_cone_4x4"
			cone_effect_sell			string:"sell_big"
			
			min_scale					float:"2.0"
			max_scale					float:"2.0"
			
			radius						float:"40"
			range						float:"40"
			//buff_mod_upkeep				float:"1.0"
			buff_modificator			float:"2.00"
			buff_source_name			string:"power_grid_balancer"
			buff_source_level			int:"4"
			buff_localization			string:"buff_name/buff_power_grid_balancer"
			buff_icon					string:"gui/hud/building_icons/energy_storage"
			
			display_radius_blueprint	string:"effects/decals/range_circle_repair"
			display_radius_group		string:"power_grid_balancer"
		}
	}
	
	HealthDesc
	{
		max_health 					"1750"
		health 						"1750"
		regeneration 				"0"
		regeneration_cooldown 		"0"
		 is_manual 1
		update_health_uniform 		"1"


		DestructionLevels
		{
			DestructionLevel
			{
				health 								"66"
				destroy_comp_delay 					"0"
				destroy_comp_event 					"66_destroy"
				destroyed_state_effect_group 		"66_state"
			}
			DestructionLevel
			{
				health 								"33"
				destroy_comp_delay 					"0"
				destroy_comp_event 					"33_destroy"
				destroyed_state_effect_group 		"33_state"
			}
		}
	}

	MeshDesc
	{
		mesh "meshes/buildings/energy/energy_storage_lvl_2.mesh"
		material "buildings/energy/energy_enhancer_lvl_1"
	}

	SkeletonDesc
	{
		name "meshes/buildings/energy/energy_enhancer_lvl_1"
	}

	EffectDesc
	{
		EffectBaseBlueprints
		{
			"buildings/effects_electric_small_base"
		}
		////////////////////////Resources/////////////////////////
		EffectGroup
		{
			group "att_in_1"
			enabled "0"
			delay "0"
			
			Effects
			{
				Effect
				{
					blueprint "effects/buildings_and_machines/building_arrow"
					bone "att_in_1_arrow"
					scale 0.5 0.5 0.5
				}
			}
		}
		////////////////////////MISC/////////////////////////
		EffectGroup
		{
			group "vismod"
			enabled "1"	
			Effects
			{
				Effect
				{
					blueprint "effects/buildings_and_machines/pipe"
					bone 	"att_in_1_pipe"
					scale 0.5 0.5 0.5
				}
				Effect
				{
					blueprint "effects/buildings_and_machines/pipe"
					bone 	"att_in_2_pipe"
					scale 0.5 0.5 0.5
				}
				Effect
				{
					blueprint "effects/buildings_and_machines/storage1"
					bone "att_vismod_base"
					scale 0.73 0.6 0.73
					orientation 0 0 0
					offset 0 0 0
				}
			}
		}
		EffectGroup
		{
			group "powered"
			enabled "1"

			Effects
			{
				Effect
				{
					blueprint "effects/buildings_and_machines/building_2x2_omni_light"
					bone "att_light"
					//random_delay "0.1"
				}
			}
		}
		EffectGroup
		{
			group "level"
			enabled "0"
			Effects
			{
				Effect
				{
					blueprint "effects/buildings_and_machines/level_2"
					bone "att_level"
				}
			}
		}
		EffectGroup
		{
			group "working"
			enabled "1"
			
			Effects
			{
				Effect
				{
					blueprint "effects/buildings_energy/energy_storage_working"	
					delay "0.5"
				}
			}
		}
	}
}

