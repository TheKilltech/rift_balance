import * from "materials/scripts/particles.material"


material particles/missing_ore_mill : particles/default
{
	set_texture_alias	diffuse			materials/textures/particles/missing_ore_mill_icon.dds
}

material particles/missing_geoscanner : particles/default
{
	set_texture_alias	diffuse			materials/textures/particles/missing_geoscanner_icon.dds
}

material particles/missing_magnetic_stabilizer : particles/default
{
	set_texture_alias	diffuse			materials/textures/particles/missing_magnetic_stabilizer.dds
}

material particles/missing_buff : particles/default
{
	set_texture_alias	diffuse			materials/textures/particles/missing_buff.dds
}

material particles/jamming_info : particles/default
{
	set_texture_alias	diffuse			materials/textures/particles/jamming.dds
}

material particles/jamming_total_info : particles/default
{
	set_texture_alias	diffuse			materials/textures/particles/jamming_total.dds
}

material particles/lightning_bolt_4x4_yellow_01 : particles/emissive
{
	set_texture_alias	diffuse			materials/textures/particles/lightning_bolt_4x4_yellow_01.dds
	set_texture_alias	emissive		materials/textures/particles/lightning_bolt_4x4_blue_01_emissive.dds
}

material particles/enemy_bullet_medium_01_blue : particles/emissive
{
	set_texture_alias	diffuse			materials/textures/particles/enemy_bullet_medium_01_blue.dds
	set_texture_alias	emissive		materials/textures/particles/enemy_bullet_medium_01_bright_emissive.dds
}

material particles/spark_purple_01 : particles/emissive
{
	set_texture_alias	diffuse			materials/textures/particles/spark_purple_01.dds
	set_texture_alias	emissive		materials/textures/particles/spark_red_01_emissive.dds
}

material particles/alien_plasma_hit_purple_atlas : particles/emissive
{
	set_texture_alias	diffuse			materials/textures/particles/alien_plasma_hit_purple_atlas.dds
	set_texture_alias	emissive		materials/textures/particles/alien_plasma_hit_atlas_emissive.dds
}