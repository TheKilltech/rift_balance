import * from "materials/scripts/gui.material"



// acid_shredder

material gui/hud/items_icons/weapons/acid_shredder : gui/default
{
	set_texture_alias diffuse materials/textures/gui/hud/items_icons/weapons/acid_shredder.dds
}

material gui/hud/items_icons/weapons/acid_shredder_superior : gui/default
{
	set_texture_alias diffuse materials/textures/gui/hud/items_icons/weapons/acid_shredder_superior.dds
}

material gui/hud/items_icons/weapons/acid_shredder_extreme : gui/default
{
	set_texture_alias diffuse materials/textures/gui/hud/items_icons/weapons/acid_shredder_extreme.dds
}

material gui/hud/items_icons/weapons/acid_shredder_advanced : gui/default
{
	set_texture_alias diffuse materials/textures/gui/hud/items_icons/weapons/acid_shredder_advanced.dds
}

